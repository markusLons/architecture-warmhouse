@startuml
!include <C4/C4_Container>
title Тёплый дом — контейнеры To-Be
Person(user, "Пользователь", "Имеет доступ к дому")
System_Ext(sensors, "Датчики", "Измеряют параметры")
System_Ext(devices, "Исполнительные устройства", "Выполняют команды")
System_Ext(cameras, "Камеры", "Предоставляют видеопоток")
System_Boundary(home, "Тёплый дом") {
    Container(player, "RTSP-плеер", "Например, VLC", "Воспроизводит поток по ссылке")
    Container(web, "Веб-интерфейс", "HTML / JavaScript", "Просмотр данных и управление")
    Container(sensorService, "Сервис сенсоров", "Go", "Получает и хранит показания")
    Container(actuatorService, "Сервис исполнительных устройств", "Go", "Передаёт команды, учитывает результаты")
    Container(cameraService, "Сервис камер", "Go", "Предоставляет доступ к видео")
    Container(deviceRegistry, "Реестр устройств", "Go", "Хранит устройства и их принадлежность домам")
    Container(scenarioService, "Сервис сценариев", "Go", "Проверяет правила и формирует команды")
    Container(aggregator, "Агрегатор информации", "Go", "Собирает сводку по дому")
    ContainerQueue(messageBroker, "Брокер сообщений", "Технология не выбрана", "Измерения, команды и результаты")
    ContainerDb(db, "Хранилища сервисов", "PostgreSQL", "Отдельные схемы и права доступа для каждого сервиса")
}
Rel(user, web, "Использует")
Rel(web, aggregator, "Запрашивает сводку", "HTTP")
Rel(aggregator, deviceRegistry, "Получает устройства", "HTTP")
Rel(aggregator, sensorService, "Получает показания", "HTTP")
Rel(aggregator, actuatorService, "Получает состояния", "HTTP")
Rel(web, deviceRegistry, "Управляет устройствами", "HTTP")
Rel(web, actuatorService, "Отправляет команды", "HTTP")
Rel(web, cameraService, "Получает RTSP-ссылку", "HTTP")
Rel(web, scenarioService, "Настраивает правила", "HTTP")
Rel(sensorService, sensors, "Опрашивает")
Rel(actuatorService, devices, "Передаёт команды, получает подтверждения")
Rel(web, player, "Передаёт полученную RTSP-ссылку")
Rel(player, cameras, "Получает видеопоток", "RTSP")
Rel(sensorService, messageBroker, "Публикует измерения")
Rel(messageBroker, scenarioService, "Доставляет измерения и результаты")
Rel(scenarioService, messageBroker, "Отправляет команды")
Rel(messageBroker, actuatorService, "Доставляет команды")
Rel(actuatorService, messageBroker, "Публикует результаты")
Rel(deviceRegistry, db, "Хранит реестр в своей схеме", "SQL")
Rel(sensorService, db, "Хранит показания в своей схеме", "SQL")
Rel(actuatorService, db, "Хранит команды и состояния в своей схеме", "SQL")
Rel(cameraService, db, "Хранит настройки камер в своей схеме", "SQL")
Rel(scenarioService, db, "Хранит правила в своей схеме", "SQL")
' Служебные HTTP-запросы сервисов к реестру раскрыты на диаграммах компонентов.
@enduml
