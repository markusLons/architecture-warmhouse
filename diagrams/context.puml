@startuml
!include <C4/C4_Context>

title Контекст системы «Тёплый дом»

Person(user, "Пользователь", "Владелец дома")
System(Home, "Тёплый дом", "Мониторинг температуры и управление отоплением")

System_Ext(Sensors, "Датчики температуры", "Внешние датчики в доме")

System_Ext(HeatingController, "Контроллер отопления", "Реле, управляющее отоплением")


Rel(user, Home, "Просматривает температуру, включает и выключает отопление")
Rel(Sensors, Home, "Передаёт информацию о температуре")
Rel(Home, HeatingController, "Отправляет команды включения и выключения")
@enduml
