@startuml
!include <C4/C4_Component>
title Реестр устройств
Container(web, "Веб-интерфейс", "", "Управляет устройствами")
Container(aggregator, "Агрегатор", "Go", "Запрашивает список устройств")
Container(services, "Сервисы сенсоров, исполнителей, камер и сценариев", "Go", "Запрашивают сведения об устройствах")
ContainerDb(db, "БД реестра", "PostgreSQL", "Пользователи, дома, доступы, типы и устройства")
Container_Boundary(registry, "Реестр устройств") {
    Component(api, "API устройств", "Go", "Принимает запросы чтения и изменения")
    Component(manager, "Управление устройствами", "Go", "Проверяет доступ к дому, тип и данные устройства")
    Component(repository, "Доступ к данным", "Go", "Читает и сохраняет записи реестра")
}
Rel(web, api, "Регистрирует, изменяет и удаляет устройства", "HTTP")
Rel(aggregator, api, "Получает список устройств", "HTTP")
Rel(services, api, "Получают сведения об устройствах", "HTTP")
Rel(api, manager, "Передаёт запрос")
Rel(manager, repository, "Читает и изменяет записи")
Rel(repository, db, "Читает и записывает", "SQL")
@enduml
